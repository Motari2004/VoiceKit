"""
VoiceKit — Text-to-Speech API and Web UI
Calls the Kokoro Space on Hugging Face and exposes a clean local API.

Run: python app.py
Open: http://localhost:5000
"""

import io
import re
import time
import threading
import requests
from flask import Flask, render_template, request, jsonify, send_file
from flask_cors import CORS

# ---------- CONFIG ----------
SPACE_URL = "https://motari-txt2speech.hf.space"
PORT = 5000

app = Flask(__name__)
CORS(app)

# Simple in-memory cache so repeat phrases are instant
_cache = {}
_cache_lock = threading.Lock()


# ---------- CORE ----------
def generate_speech(text, voice="am_adam", speed=1.0):
    """Call the HF Space and return WAV bytes."""
    key = f"{voice}|{speed}|{text}"
    with _cache_lock:
        if key in _cache:
            return _cache[key]

    # Step 1 — start the job
    start = requests.post(
        f"{SPACE_URL}/gradio_api/call/tts",
        json={"data": [text, voice, speed]},
        timeout=30,
    )
    start.raise_for_status()
    eid = start.json().get("event_id")
    if not eid:
        raise RuntimeError("No event_id returned from Space")

    # Step 2 — poll for the result
    audio_url = None
    for _ in range(60):          # up to ~30 seconds
        res = requests.get(
            f"{SPACE_URL}/gradio_api/call/tts/{eid}",
            timeout=30,
        )
        res.raise_for_status()
        raw = res.text

        match = re.search(r'https://[^"]+audio\.wav', raw)
        if match:
            audio_url = match.group(0)
            break

        time.sleep(0.5)

    if not audio_url:
        raise TimeoutError("Space did not return an audio URL in time")

    # Step 3 — download the WAV
    audio = requests.get(audio_url, timeout=30)
    audio.raise_for_status()
    wav_bytes = audio.content

    with _cache_lock:
        _cache[key] = wav_bytes

    return wav_bytes


# ---------- ROUTES ----------
@app.route("/")
def index():
    return render_template("index.html")


@app.route("/health")
def health():
    return jsonify({"status": "ok", "time": time.time()})


@app.route("/voices")
def voices():
    return jsonify({
        "voices": [
            {"id": "am_adam",    "name": "Adam",     "gender": "Male",   "accent": "American"},
            {"id": "am_michael", "name": "Michael",  "gender": "Male",   "accent": "American"},
            {"id": "am_onyx",    "name": "Onyx",     "gender": "Male",   "accent": "American"},
            {"id": "am_puck",    "name": "Puck",     "gender": "Male",   "accent": "American"},
            {"id": "am_echo",    "name": "Echo",     "gender": "Male",   "accent": "American"},
            {"id": "am_eric",    "name": "Eric",     "gender": "Male",   "accent": "American"},
            {"id": "am_fenrir",  "name": "Fenrir",   "gender": "Male",   "accent": "American"},
            {"id": "am_liam",    "name": "Liam",     "gender": "Male",   "accent": "American"},
            {"id": "am_santa",   "name": "Santa",    "gender": "Male",   "accent": "American"},
            {"id": "bm_george",  "name": "George",   "gender": "Male",   "accent": "British"},
            {"id": "bm_lewis",   "name": "Lewis",    "gender": "Male",   "accent": "British"},
            {"id": "bm_daniel",  "name": "Daniel",   "gender": "Male",   "accent": "British"},
            {"id": "bm_fable",   "name": "Fable",    "gender": "Male",   "accent": "British"},
            {"id": "af_heart",   "name": "Heart",    "gender": "Female", "accent": "American"},
            {"id": "af_bella",   "name": "Bella",    "gender": "Female", "accent": "American"},
            {"id": "af_nicole",  "name": "Nicole",   "gender": "Female", "accent": "American"},
            {"id": "af_sarah",   "name": "Sarah",    "gender": "Female", "accent": "American"},
            {"id": "af_sky",     "name": "Sky",      "gender": "Female", "accent": "American"},
            {"id": "af_nova",    "name": "Nova",     "gender": "Female", "accent": "American"},
            {"id": "bf_emma",    "name": "Emma",     "gender": "Female", "accent": "British"},
            {"id": "bf_alice",   "name": "Alice",    "gender": "Female", "accent": "British"},
            {"id": "bf_lily",    "name": "Lily",     "gender": "Female", "accent": "British"},
        ]
    })


@app.route("/speak", methods=["POST"])
def speak():
    """Single POST, returns WAV directly."""
    try:
        data  = request.get_json() or {}
        text  = (data.get("text") or "").strip()
        voice = (data.get("voice") or "am_adam").strip()
        speed = float(data.get("speed", 1.0))

        if not text:
            return jsonify({"error": "Missing 'text'"}), 400
        if len(text) > 800:
            return jsonify({"error": "Text too long (max 800 chars)"}), 400
        if speed < 0.5 or speed > 2.0:
            speed = 1.0

        wav_bytes = generate_speech(text, voice, speed)

        return send_file(
            io.BytesIO(wav_bytes),
            mimetype="audio/wav",
            as_attachment=False,
            download_name=f"{voice}.wav",
        )
    except requests.Timeout:
        return jsonify({"error": "Space timed out — try again"}), 504
    except Exception as e:
        return jsonify({"error": str(e)[:250]}), 500


@app.route("/speak-b64", methods=["POST"])
def speak_b64():
    """Alternative — returns base64 WAV in JSON."""
    import base64
    try:
        data  = request.get_json() or {}
        text  = (data.get("text") or "").strip()
        voice = (data.get("voice") or "am_adam").strip()
        speed = float(data.get("speed", 1.0))

        if not text:
            return jsonify({"error": "Missing 'text'"}), 400

        wav_bytes = generate_speech(text, voice, speed)

        return jsonify({
            "status": "ok",
            "voice": voice,
            "speed": speed,
            "size": len(wav_bytes),
            "audio_b64": base64.b64encode(wav_bytes).decode("utf-8"),
        })
    except Exception as e:
        return jsonify({"error": str(e)[:250]}), 500


@app.route("/clear-cache", methods=["POST"])
def clear_cache():
    with _cache_lock:
        _cache.clear()
    return jsonify({"status": "cleared", "entries": 0})


@app.route("/cache-stats")
def cache_stats():
    with _cache_lock:
        total = sum(len(v) for v in _cache.values())
        return jsonify({
            "entries": len(_cache),
            "total_kb": round(total / 1024, 1),
        })


# ---------- START ----------
if __name__ == "__main__":
    print("=" * 55)
    print("  VoiceKit")
    print(f"  http://localhost:{PORT}")
    print("  POST /speak        — generate speech (WAV)")
    print("  POST /speak-b64    — generate speech (base64)")
    print("  GET  /voices       — list available voices")
    print("  GET  /health       — health check")
    print("=" * 55)
    app.run(host="0.0.0.0", port=PORT, debug=False, threaded=True)