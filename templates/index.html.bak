          </div>
          <button class="chip-play" data-id="af_aoede" title="Preview Aoede">▶</button>
        </div>
        <div class="voice-chip" data-id="af_alloy" data-name="alloy" data-lang="American English" data-gender="female" title="Alloy — Bright, energetic">
          <div class="chip-content">
            <span class="chip-name">Alloy</span>
