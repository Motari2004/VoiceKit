          </div>
          <button class="chip-play" data-id="af_alloy" title="Preview Alloy">▶</button>
        </div>
      </div>
    </div>
    <div class="voice-lang" data-lang="British English">
      <div class="voice-lang-header">British English</div>
      <div class="voice-gender-label">Male</div>
      <div class="voice-chips">
        <div class="voice-chip" data-id="bm_george" data-name="george" data-lang="British English" data-gender="male" title="George — Warm, refined">
          <div class="chip-content">
            <span class="chip-name">George</span>
            <span class="chip-desc">Warm, refined</span>
          </div>
          <button class="chip-play" data-id="bm_george" title="Preview George">▶</button>
        </div>
        <div class="voice-chip" data-id="bm_lewis" data-name="lewis" data-lang="British English" data-gender="male" title="Lewis — Deep, authoritative">
          <div class="chip-content">
            <span class="chip-name">Lewis</span>
            <span class="chip-desc">Deep, authoritative</span>
          </div>
          <button class="chip-play" data-id="bm_lewis" title="Preview Lewis">▶</button>
        </div>
        <div class="voice-chip" data-id="bm_daniel" data-name="daniel" data-lang="British English" data-gender="male" title="Daniel — Clear, articulate">
          <div class="chip-content">
            <span class="chip-name">Daniel</span>
            <span class="chip-desc">Clear, articulate</span>
          </div>
          <button class="chip-play" data-id="bm_daniel" title="Preview Daniel">▶</button>
        </div>
        <div class="voice-chip" data-id="bm_fable" data-name="fable" data-lang="British English" data-gender="male" title="Fable — Storyteller, warm">
          <div class="chip-content">
            <span class="chip-name">Fable</span>
            <span class="chip-desc">Storyteller, warm</span>
          </div>
          <button class="chip-play" data-id="bm_fable" title="Preview Fable">▶</button>
        </div>
      </div>
      <div class="voice-gender-label">Female</div>
      <div class="voice-chips">
        <div class="voice-chip" data-id="bf_emma" data-name="emma" data-lang="British English" data-gender="female" title="Emma — Warm, elegant">
          <div class="chip-content">
            <span class="chip-name">Emma</span>
            <span class="chip-desc">Warm, elegant</span>
          </div>
          <button class="chip-play" data-id="bf_emma" title="Preview Emma">▶</button>
        </div>
        <div class="voice-chip" data-id="bf_alice" data-name="alice" data-lang="British English" data-gender="female" title="Alice — Clear, bright">
          <div class="chip-content">
            <span class="chip-name">Alice</span>
            <span class="chip-desc">Clear, bright</span>
          </div>
          <button class="chip-play" data-id="bf_alice" title="Preview Alice">▶</button>
        </div>
        <div class="voice-chip" data-id="bf_isabella" data-name="isabella" data-lang="British English" data-gender="female" title="Isabella — Refined, smooth">
          <div class="chip-content">
            <span class="chip-name">Isabella</span>
            <span class="chip-desc">Refined, smooth</span>
          </div>
          <button class="chip-play" data-id="bf_isabella" title="Preview Isabella">▶</button>
        </div>
        <div class="voice-chip" data-id="bf_lily" data-name="lily" data-lang="British English" data-gender="female" title="Lily — Youthful, gentle">
          <div class="chip-content">
            <span class="chip-name">Lily</span>
            <span class="chip-desc">Youthful, gentle</span>
          </div>
          <button class="chip-play" data-id="bf_lily" title="Preview Lily">▶</button>
        </div>
