<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>VoiceKit — Neural Text to Speech Studio</title>
<meta name="description" content="Next-generation natural text-to-speech with 54 studio voices. Fast, offline-capable, developer-ready.">
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎙️</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

<style>
  :root {
    --bg-0: #030408;
    --bg-1: #070913;
    --bg-2: #0e1224;
    
    --surface: rgba(18, 24, 43, 0.7);
    --surface-hover: rgba(26, 34, 60, 0.8);
    --surface-glass: rgba(255, 255, 255, 0.02);
    
    --border: rgba(255, 255, 255, 0.06);
    --border-bright: rgba(34, 211, 238, 0.3);
    
    --cyan: #22d3ee;
    --cyan-glow: rgba(34, 211, 238, 0.25);
    --purple: #a855f7;
    --purple-glow: rgba(168, 85, 247, 0.25);
    --pink: #ec4899;
    --green: #34d399;
    --amber: #fbbf24;
    --red: #f87171;

    --text-main: #f3f4f6;
    --text-muted: #9ca3af;
    --text-dim: #6b7280;

    --radius-lg: 20px;
    --radius-md: 12px;
    --radius-sm: 8px;
    
    --transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    min-height: 100vh;
    background: var(--bg-0);
    color: var(--text-main);
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 15px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  body {
    background-image: 
      radial-gradient(circle at 10% 10%, rgba(34, 211, 238, 0.08), transparent 40%),
      radial-gradient(circle at 90% 20%, rgba(168, 85, 247, 0.08), transparent 40%),
      radial-gradient(circle at 50% 90%, rgba(236, 72, 153, 0.05), transparent 50%),
      radial-gradient(circle at 80% 80%, rgba(34, 211, 238, 0.04), transparent 30%);
    background-attachment: fixed;
    padding: 48px 20px 80px;
  }

  .container {
    max-width: 780px;
    margin: 0 auto;
  }

  /* ---------- HEADER ---------- */
  .header {
    text-align: center;
    margin-bottom: 48px;
    position: relative;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 12px;
  }

  .logo-mark {
    width: 52px;
    height: 52px;
    border-radius: 16px;
    background: linear-gradient(135deg, var(--cyan), var(--purple));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    box-shadow: 0 8px 32px var(--cyan-glow);
    position: relative;
  }

  .logo-mark::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 16px;
    background: linear-gradient(135deg, rgba(255,255,255,0.4), transparent);
    pointer-events: none;
  }

  h1 {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    background: linear-gradient(135deg, #fff 30%, var(--cyan) 70%, var(--purple));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .tagline {
    color: var(--text-muted);
    font-size: 1rem;
    font-weight: 500;
    margin-top: 4px;
  }

  .badges {
    display: flex;
    gap: 10px;
    justify-content: center;
    margin-top: 16px;
    flex-wrap: wrap;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: rgba(34, 211, 238, 0.06);
    border: 1px solid rgba(34, 211, 238, 0.18);
    border-radius: 30px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--cyan);
    text-transform: uppercase;
    backdrop-filter: blur(10px);
  }

  .badge::before {
    content: "";
    width: 6px;
    height: 6px;
    background: var(--cyan);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--cyan);
  }

  /* ---------- CARD SYSTEM ---------- */
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px;
    margin-bottom: 20px;
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.04);
    transition: var(--transition);
  }

  .card:hover {
    border-color: rgba(255, 255, 255, 0.1);
  }

  /* ---------- INPUT & AREA ---------- */
  .input-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .char-count {
    font-size: 0.75rem;
    color: var(--text-dim);
    font-family: 'JetBrains Mono', monospace;
  }
  .char-count.warn { color: var(--amber); }
  .char-count.over { color: var(--red); }

  textarea {
    width: 100%;
    padding: 18px;
    background: rgba(3, 4, 8, 0.5);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text-main);
    font-size: 1rem;
    font-family: inherit;
    resize: vertical;
    min-height: 130px;
    outline: none;
    transition: var(--transition);
    line-height: 1.6;
  }

  textarea:focus {
    border-color: var(--cyan);
    box-shadow: 0 0 0 4px var(--cyan-glow);
    background: rgba(3, 4, 8, 0.8);
  }

  textarea::placeholder { color: var(--text-dim); }

  /* ---------- QUICK PRESETS ---------- */
  .quick {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .quick button {
    padding: 6px 14px;
    background: var(--surface-glass);
    border: 1px solid var(--border);
    border-radius: 20px;
    color: var(--text-muted);
    font-size: 0.75rem;
    font-family: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition);
  }

  .quick button:hover {
    background: rgba(34, 211, 238, 0.08);
    border-color: var(--border-bright);
    color: var(--cyan);
    transform: translateY(-1px);
  }

  /* ---------- VOICE PICKER ---------- */
  .voice-picker { margin-top: 8px; }

  .search-wrap {
    position: relative;
    margin-bottom: 12px;
  }

  .search-wrap svg {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: var(--text-dim);
    pointer-events: none;
  }

  #voiceSearch {
    width: 100%;
    padding: 12px 16px 12px 44px;
    background: rgba(3, 4, 8, 0.5);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text-main);
    font-size: 0.9rem;
    font-family: inherit;
    outline: none;
    transition: var(--transition);
  }

  #voiceSearch:focus {
    border-color: var(--cyan);
    box-shadow: 0 0 0 4px var(--cyan-glow);
  }

  .filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 16px;
  }

  .filter-chip {
    padding: 6px 14px;
    background: var(--surface-glass);
    border: 1px solid var(--border);
    border-radius: 20px;
    color: var(--text-muted);
    font-size: 0.75rem;
    font-family: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition);
  }

  .filter-chip:hover {
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-main);
  }

  .filter-chip.active {
    background: rgba(34, 211, 238, 0.12);
    border-color: var(--cyan);
    color: var(--cyan);
    box-shadow: 0 0 12px rgba(34, 211, 238, 0.15);
  }

  .voice-count {
    font-size: 0.72rem;
    color: var(--text-dim);
    text-align: right;
    margin-bottom: 10px;
    font-family: 'JetBrains Mono', monospace;
  }

  .voice-list {
    max-height: 380px;
    overflow-y: auto;
    padding-right: 6px;
    margin-bottom: 16px;
  }

  .voice-list::-webkit-scrollbar { width: 6px; }
  .voice-list::-webkit-scrollbar-track { background: transparent; }
  .voice-list::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.08);
    border-radius: 3px;
  }
  .voice-list::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  .voice-lang { margin-bottom: 20px; }
  .voice-lang.hidden { display: none; }

  .voice-lang-header {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--cyan);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 12px;
    padding-bottom: 6px;
    border-bottom: 1px solid rgba(34, 211, 238, 0.1);
  }

  .voice-lang-header::before {
    content: "";
    width: 3px;
    height: 12px;
    background: var(--cyan);
    border-radius: 2px;
    box-shadow: 0 0 8px var(--cyan);
  }

  .voice-gender-label {
    font-size: 0.65rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 12px 0 8px;
    font-weight: 700;
  }

  .voice-chips {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 8px;
  }

  .voice-chip {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    background: rgba(255, 255, 255, 0.015);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: var(--transition);
    position: relative;
    overflow: hidden;
  }

  .voice-chip.hidden { display: none; }

  .voice-chip:hover {
    background: rgba(34, 211, 238, 0.04);
    border-color: rgba(34, 211, 238, 0.25);
    transform: translateY(-2px);
  }

  .voice-chip.selected {
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.12), rgba(168, 85, 247, 0.1));
    border-color: var(--cyan);
    box-shadow: 0 0 20px rgba(34, 211, 238, 0.15);
  }

  .voice-chip.selected::after {
    content: "✓";
    position: absolute;
    top: 6px;
    right: 8px;
    font-size: 0.65rem;
    color: var(--cyan);
    font-weight: 800;
  }

  .chip-content {
    flex: 1;
    min-width: 0;
  }

  .chip-name {
    display: block;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-main);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .chip-desc {
    display: block;
    font-size: 0.68rem;
    color: var(--text-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-top: 1px;
  }

  .chip-play {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(34, 211, 238, 0.08);
    border: 1px solid rgba(34, 211, 238, 0.2);
    border-radius: 50%;
    color: var(--cyan);
    cursor: pointer;
    font-size: 0.55rem;
    padding: 0;
    transition: var(--transition);
  }

  .chip-play:hover {
    background: var(--cyan);
    color: #000;
    transform: scale(1.15);
    box-shadow: 0 0 10px var(--cyan);
  }

  .chip-play.playing {
    background: var(--cyan);
    color: #000;
    animation: pulse-play 1s infinite;
  }

  @keyframes pulse-play {
    0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(34, 211, 238, 0.4); }
    50% { transform: scale(1.08); box-shadow: 0 0 12px rgba(34, 211, 238, 0.8); }
  }

  /* ---------- SELECTED BAR ---------- */
  .selected-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.06), rgba(168, 85, 247, 0.06));
    border: 1px solid rgba(34, 211, 238, 0.2);
    border-radius: var(--radius-sm);
  }

  .selected-bar .label {
    font-size: 0.68rem;
    color: var(--text-dim);
    letter-spacing: 0.1em;
  }

  .selected-bar .name {
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
  }

  .selected-bar .id {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--cyan);
    background: rgba(34, 211, 238, 0.08);
    padding: 3px 8px;
    border-radius: 6px;
  }

  /* ---------- CONTROLS & SPEAK BUTTON ---------- */
  .controls-row {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 4px;
  }

  .speed-control {
    display: flex;
    align-items: center;
    gap: 16px;
    background: rgba(3, 4, 8, 0.3);
    padding: 14px 18px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
  }

  .speed-control label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    min-width: 50px;
  }

  input[type=range] {
    flex: 1;
    height: 6px;
    -webkit-appearance: none;
    appearance: none;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 3px;
    outline: none;
    accent-color: var(--cyan);
  }

  input[type=range]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 18px;
    height: 18px;
    background: var(--cyan);
    border-radius: 50%;
    cursor: pointer;
    box-shadow: 0 0 12px var(--cyan);
    transition: var(--transition);
  }

  input[type=range]::-webkit-slider-thumb:hover {
    transform: scale(1.2);
    box-shadow: 0 0 18px var(--cyan);
  }

  .speed-value {
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--cyan);
    min-width: 55px;
    text-align: right;
    font-family: 'JetBrains Mono', monospace;
  }

  .speak-btn {
    width: 100%;
    padding: 18px;
    background: linear-gradient(135deg, var(--cyan), var(--purple));
    border: none;
    border-radius: var(--radius-md);
    color: #030408;
    font-size: 1rem;
    font-weight: 800;
    font-family: inherit;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: var(--transition);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    box-shadow: 0 8px 32px var(--cyan-glow);
    position: relative;
    overflow: hidden;
  }

  .speak-btn::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(rgba(255,255,255,0.2), transparent);
    opacity: 0;
    transition: var(--transition);
  }

  .speak-btn:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(34, 211, 238, 0.4);
  }

  .speak-btn:hover:not(:disabled)::after { opacity: 1; }
  .speak-btn:active:not(:disabled) { transform: translateY(0); }

  .speak-btn:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .speak-btn.generating {
    animation: pulse-btn 1.5s infinite;
  }

  @keyframes pulse-btn {
    0%, 100% { box-shadow: 0 8px 32px var(--cyan-glow); }
    50% { box-shadow: 0 8px 48px rgba(168, 85, 247, 0.6); }
  }

  /* ---------- STATUS & PLAYER ---------- */
  .status {
    margin-top: 14px;
    padding: 14px 16px;
    background: rgba(3, 4, 8, 0.4);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace;
    min-height: 24px;
    transition: var(--transition);
  }

  .status.ok { color: var(--green); background: rgba(52, 211, 153, 0.06); border-color: rgba(52, 211, 153, 0.2); }
  .status.err { color: var(--red); background: rgba(248, 113, 113, 0.06); border-color: rgba(248, 113, 113, 0.2); }
  .status.busy { color: var(--amber); background: rgba(251, 191, 36, 0.06); border-color: rgba(251, 191, 36, 0.2); }

  audio {
    width: 100%;
    margin-top: 14px;
    display: none;
    border-radius: var(--radius-sm);
  }
  audio.show { display: block; }

  /* ---------- HISTORY ---------- */
  .history-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 14px;
    margin-bottom: 8px;
    background: rgba(3, 4, 8, 0.3);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    transition: var(--transition);
  }

  .history-item:hover { background: rgba(3, 4, 8, 0.6); border-color: rgba(255, 255, 255, 0.1); }
  .history-item .info { flex: 1; min-width: 0; }

  .history-item .text {
    font-size: 0.85rem;
    color: var(--text-main);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-weight: 500;
  }

  .history-item .meta {
    font-size: 0.7rem;
    color: var(--text-dim);
    margin-top: 3px;
    font-family: 'JetBrains Mono', monospace;
  }

  .history-item button {
    padding: 6px 14px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.25);
    border-radius: 6px;
    color: var(--cyan);
    font-size: 0.72rem;
    font-weight: 700;
    font-family: inherit;
    cursor: pointer;
    transition: var(--transition);
    flex-shrink: 0;
  }

  .history-item button:hover {
    background: rgba(34, 211, 238, 0.25);
    box-shadow: 0 0 10px rgba(34, 211, 238, 0.2);
  }

  .empty {
    color: var(--text-dim);
    font-size: 0.85rem;
    text-align: center;
    padding: 20px;
    font-style: italic;
  }

  /* ---------- API SECTION ---------- */
  .api-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    padding: 4px 0;
    user-select: none;
  }

  .api-toggle h3 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-main);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .api-toggle-icon {
    color: var(--text-dim);
    font-size: 0.8rem;
    transition: transform 0.3s ease;
  }

  .api-toggle.open .api-toggle-icon {
    transform: rotate(180deg);
  }

  .api-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .api-body.open {
    max-height: 3000px;
    margin-top: 18px;
  }

  .api-block { margin-bottom: 16px; }

  .api-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 6px;
    font-weight: 600;
  }

  .api-label strong { color: var(--text-main); font-weight: 700; }

  .api-code {
    display: block;
    padding: 14px 16px;
    background: #020305;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: #38bdf8;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    overflow-x: auto;
    white-space: pre;
    line-height: 1.6;
  }

  .api-endpoints {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }

  .endpoint {
    padding: 6px 12px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.72rem;
    font-family: 'JetBrains Mono', monospace;
    color: var(--text-muted);
  }

  .endpoint .method {
    font-weight: 700;
    color: var(--cyan);
    margin-right: 6px;
  }

  /* ---------- FOOTER ---------- */
  .footer {
    text-align: center;
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  .footer a {
    color: var(--text-muted);
    text-decoration: none;
    transition: var(--transition);
    font-weight: 500;
  }

  .footer a:hover { color: var(--cyan); text-shadow: 0 0 8px var(--cyan-glow); }
  .footer .sep { margin: 0 10px; opacity: 0.3; }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 640px) {
    body { padding: 20px 12px 60px; }
    h1 { font-size: 2rem; }
    .card { padding: 20px; }
    .voice-chips { grid-template-columns: 1fr; }
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .card { animation: fadeIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) both; }
  .card:nth-child(2) { animation-delay: 0.05s; }
  .card:nth-child(3) { animation-delay: 0.1s; }
  .card:nth-child(4) { animation-delay: 0.15s; }
  .card:nth-child(5) { animation-delay: 0.2s; }
</style>
</head>
<body>
<div class="container">

  <!-- HEADER -->
  <div class="header">
    <div class="logo">
      <div class="logo-mark">🎙️</div>
      <h1>VoiceKit</h1>
    </div>
    <p class="tagline">Neural Text-to-Speech Studio</p>
    <div class="badges">
      <span class="badge">54 Voices</span>
      <span class="badge">9 Languages</span>
      <span class="badge">Studio Grade</span>
    </div>
  </div>

  <!-- INPUT CARD -->
  <div class="card">
    <div class="input-header">
      <span class="label">Text input</span>
      <span class="char-count" id="charCount">0 / 800</span>
    </div>

    <textarea id="text" maxlength="800" placeholder="Type or paste your text here...">Listen closely. You can barely tell this is not a human talking.</textarea>

    <div class="quick">
      <button data-p="Listen closely. You can barely tell this is not a human talking.">Natural Voice</button>
      <button data-p="Hello world, welcome to the future of voice generation.">Welcome</button>
      <button data-p="System update complete. All neural engines are now online and fully operational.">System Update</button>
      <button data-p="The night is young and the bass is deep.">Atmospheric</button>
      <button data-p="Eins, zwei, drei, vier. Neural speech synthesis is fast and accurate.">Multilingual</button>
    </div>
  </div>

  <!-- VOICE PICKER CARD -->
  <div class="card">
    <div class="input-header">
      <span class="label">Voice selection</span>
    </div>

    <div class="voice-picker">
      <div class="search-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
        <input type="text" id="voiceSearch" placeholder="Search voices by name or code..." autocomplete="off">
      </div>

      <div class="filter-row" id="voiceFilter">
        <button class="filter-chip active" data-filter="all">All</button>
        <button class="filter-chip" data-filter="male">Male</button>
        <button class="filter-chip" data-filter="female">Female</button>
        <button class="filter-chip" data-filter="American English">American</button>
        <button class="filter-chip" data-filter="British English">British</button>
        <button class="filter-chip" data-filter="Japanese">Japanese</button>
        <button class="filter-chip" data-filter="Mandarin Chinese">Mandarin</button>
        <button class="filter-chip" data-filter="Spanish">Spanish</button>
        <button class="filter-chip" data-filter="French">French</button>
        <button class="filter-chip" data-filter="Hindi">Hindi</button>
        <button class="filter-chip" data-filter="Italian">Italian</button>
        <button class="filter-chip" data-filter="Portuguese">Portuguese</button>
      </div>

      <div class="voice-count" id="voiceCount"></div>
      <div class="voice-list" id="voiceList">
        <div class="empty">Loading voices catalog...</div>
      </div>

      <div class="selected-bar">
        <div>
          <span class="label" style="display:block; margin-bottom:2px;">Active Voice</span>
          <span class="name" id="selectedName">Adam</span>
        </div>
        <span class="id" id="selectedId">am_adam</span>
      </div>
    </div>
  </div>

  <!-- CONTROLS & GENERATE CARD -->
  <div class="card">
    <div class="controls-row">
      <div class="speed-control">
        <label>Speed</label>
        <input type="range" id="speed" min="0.7" max="1.5" step="0.05" value="1.0">
        <div class="speed-value" id="speedVal">1.00×</div>
      </div>
    </div>

    <button class="speak-btn" id="speakBtn">
      <span>Generate & Play Audio</span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
    </button>

    <div class="status" id="status">Ready. Select a voice and hit generate (or Ctrl + Enter).</div>

    <audio id="player" controls></audio>
  </div>

  <!-- HISTORY CARD -->
  <div class="card">
    <div class="input-header">
      <span class="label">Generation History</span>
    </div>
    <div id="history">
      <div class="empty">No recent generations yet.</div>
    </div>
  </div>

  <!-- API CARD -->
  <div class="card">
    <div class="api-toggle" id="apiToggle">
      <h3>⚡ Developer API Endpoints</h3>
      <span class="api-toggle-icon">▼</span>
    </div>

    <div class="api-body" id="apiBody">
      <div class="api-block">
        <div class="api-label"><strong>cURL Request</strong></div>
        <code class="api-code">curl -X POST /speak \
  -H "Content-Type: application/json" \
  -d '{"text":"Hello world","voice":"am_adam","speed":1.0}' \
  -o output.wav</code>
      </div>

      <div class="api-block">
        <div class="api-label"><strong>Python Integration</strong></div>
        <code class="api-code">import requests

res = requests.post("https://voicekit-prod.vercel.app/speak", json={
    "text": "Hello world",
    "voice": "am_adam",
    "speed": 1.0,
})
open("output.wav", "wb").write(res.content)</code>
      </div>

      <div class="api-block">
        <div class="api-label"><strong>JavaScript Integration</strong></div>
        <code class="api-code">const res = await fetch("/speak", {
  method: "POST",
  headers: { "Content-Type": "application/json" },
  body: JSON.stringify({ text: "Hello world", voice: "am_adam", speed: 1.0 })
});
const blob = await res.blob();
new Audio(URL.createObjectURL(blob)).play();</code>
      </div>

      <div class="api-endpoints">
        <span class="endpoint"><span class="method">POST</span>/speak</span>
        <span class="endpoint"><span class="method">GET</span>/voices</span>
        <span class="endpoint"><span class="method">GET</span>/voices/catalog</span>
        <span class="endpoint"><span class="method">GET</span>/health</span>
      </div>
    </div>
  </div>

  <!-- FOOTER -->
  <div class="footer">
    <a href="https://huggingface.co/spaces/Motari/txt2speech" target="_blank">HuggingFace Space</a>
    <span class="sep">·</span>
    <a href="https://huggingface.co/hexgrad/Kokoro-82M" target="_blank">Kokoro-82M Engine</a>
    <span class="sep">·</span>
    <a href="/voices" target="_blank">API Docs</a>
  </div>
</div>

<script>
const API_URL = ""; 

let selectedVoiceId = "am_adam";
let selectedVoiceName = "Adam";
let currentFilter = "all";
let currentSearch = "";
let voiceCatalog = null;

const textEl = document.getElementById('text');
const speedEl = document.getElementById('speed');
const speedVal = document.getElementById('speedVal');
const speakBtn = document.getElementById('speakBtn');
const statusEl = document.getElementById('status');
const player = document.getElementById('player');
const historyEl = document.getElementById('history');
const charCount = document.getElementById('charCount');
const voiceList = document.getElementById('voiceList');
const voiceSearch = document.getElementById('voiceSearch');
const voiceFilter = document.getElementById('voiceFilter');
const voiceCount = document.getElementById('voiceCount');
const selectedName = document.getElementById('selectedName');
const selectedId = document.getElementById('selectedId');
const apiToggle = document.getElementById('apiToggle');
const apiBody = document.getElementById('apiBody');

function setStatus(msg, cls) {
  statusEl.className = 'status ' + (cls || '');
  statusEl.textContent = msg;
}

speedEl.oninput = () => {
  speedVal.textContent = parseFloat(speedEl.value).toFixed(2) + '×';
};

textEl.oninput = () => {
  const len = textEl.value.length;
  charCount.textContent = len + ' / 800';
  charCount.className = 'char-count';
  if (len > 700) charCount.classList.add('warn');
  if (len >= 800) charCount.classList.add('over');
};

textEl.oninput();

document.querySelectorAll('.quick button').forEach(btn => {
  btn.onclick = () => {
    textEl.value = btn.dataset.p;
    textEl.oninput();
    textEl.focus();
  };
});

apiToggle.onclick = () => {
  apiToggle.classList.toggle('open');
  apiBody.classList.toggle('open');
};

// Fallback catalog if backend is offline during local testing
const fallbackCatalog = {
  "American English": {
    "Female": [
      ["af_nicole", "Nicole", "Soft & Warm"],
      ["af_sarah", "Sarah", "Clear & Professional"],
      ["af_sky", "Sky", "Bright & Energetic"],
      ["af_alloy", "Alloy", "Balanced Studio"]
    ],
    "Male": [
      ["am_adam", "Adam", "Deep & Cinematic"],
      ["am_michael", "Michael", "Confident & Authoritative"],
      ["am_eric", "Eric", "Casual & Warm"]
    ]
  },
  "British English": {
    "Female": [
      ["bf_emma", "Emma", "Refined & Crisp"],
      ["bf_isabella", "Isabella", "Articulate & Smooth"]
    ],
    "Male": [
      ["bm_george", "George", "Distinguished & Deep"],
      ["bm_lewis", "Lewis", "Warm Narrative"]
    ]
  }
};

async function loadVoices() {
  try {
    const res = await fetch(`${API_URL}/voices/catalog`);
    if (!res.ok) throw new Error('Catalog endpoint unavailable');
    voiceCatalog = await res.json();
  } catch (e) {
    voiceCatalog = fallbackCatalog;
  }
  renderVoicePicker();
  updateVoiceCount();
}

function renderVoicePicker() {
  if (!voiceCatalog) return;
  voiceList.innerHTML = '';

  Object.keys(voiceCatalog).forEach(lang => {
    const groups = voiceCatalog[lang];
    const block = document.createElement('div');
    block.className = 'voice-lang';
    block.dataset.lang = lang;
    block.innerHTML = `<div class="voice-lang-header">${lang}</div>`;

    ['Female', 'Male'].forEach(gender => {
      const voices = groups[gender];
      if (!voices || voices.length === 0) return;

      const row = document.createElement('div');
      row.className = 'voice-chips';
      row.innerHTML = `<div class="voice-gender-label" style="grid-column:1/-1;">${gender}</div>`;

      voices.forEach(v => {
        const [id, name, desc] = v;
        const chip = document.createElement('div');
        const isSelected = id === selectedVoiceId;
        chip.className = 'voice-chip' + (isSelected ? ' selected' : '');
        chip.dataset.id = id;
        chip.dataset.name = name.toLowerCase();
        chip.dataset.lang = lang;
        chip.dataset.gender = gender.toLowerCase();
        
        chip.innerHTML = `
          <div class="chip-content">
            <span class="chip-name">${name}</span>
            <span class="chip-desc">${desc || ''}</span>
          </div>
          <button class="chip-play" data-id="${id}" title="Preview Voice">▶</button>
        `;

        chip.onclick = (e) => {
          if (e.target.closest('.chip-play')) return;
          selectVoice(id, name, chip);
        };

        chip.querySelector('.chip-play').onclick = (e) => {
          e.stopPropagation();
          previewVoice(id, e.target);
        };

        row.appendChild(chip);
      });

      block.appendChild(row);
    });

    voiceList.appendChild(block);
  });
}

function selectVoice(id, name, chip) {
  selectedVoiceId = id;
  selectedVoiceName = name;
  selectedName.textContent = name;
  selectedId.textContent = id;

  document.querySelectorAll('.voice-chip').forEach(c => c.classList.remove('selected'));
  if (chip) chip.classList.add('selected');
}

function updateVoiceCount() {
  const visible = document.querySelectorAll('.voice-chip:not(.hidden)').length;
  voiceCount.textContent = `${visible} voice${visible === 1 ? '' : 's'} available`;
}

voiceSearch.oninput = (e) => {
  currentSearch = e.target.value.toLowerCase().trim();
  applyFilters();
};

voiceFilter.onclick = (e) => {
  const chip = e.target.closest('.filter-chip');
  if (!chip) return;
  voiceFilter.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
  chip.classList.add('active');
  currentFilter = chip.dataset.filter;
  applyFilters();
};

function applyFilters() {
  document.querySelectorAll('.voice-chip').forEach(chip => {
    const id = chip.dataset.id.toLowerCase();
    const name = chip.dataset.name;
    const lang = chip.dataset.lang;
    const gender = chip.dataset.gender;

    const matchesSearch = !currentSearch || id.includes(currentSearch) || name.includes(currentSearch);

    let matchesFilter = true;
    if (currentFilter === 'male') matchesFilter = gender === 'male';
    else if (currentFilter === 'female') matchesFilter = gender === 'female';
    else if (currentFilter !== 'all') matchesFilter = lang === currentFilter;

    chip.classList.toggle('hidden', !(matchesSearch && matchesFilter));
  });

  document.querySelectorAll('.voice-lang').forEach(block => {
    const any = block.querySelectorAll('.voice-chip:not(.hidden)').length;
    block.classList.toggle('hidden', any === 0);
  });

  updateVoiceCount();
}

async function previewVoice(voiceId, btn) {
  if (btn) {
    btn.textContent = '⏳';
    btn.classList.add('playing');
  }

  try {
    const res = await fetch(`${API_URL}/speak`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        text: "Sample preview audio.",
        voice: voiceId,
        speed: 1.0
      })
    });

    if (!res.ok) throw new Error('Preview failed');
    const blob = await res.blob();
    const audio = new Audio(URL.createObjectURL(blob));
    audio.play();

    if (btn) {
      btn.textContent = '■';
      audio.onended = () => {
        btn.textContent = '▶';
        btn.classList.remove('playing');
      };
    }
  } catch (e) {
    if (btn) {
      btn.textContent = '▶';
      btn.classList.remove('playing');
    }
    setStatus('Voice preview failed: ' + e.message, 'err');
  }
}

async function generateSpeech() {
  const text = textEl.value.trim();
  if (!text) {
    setStatus('Please enter some text to speak.', 'err');
    textEl.focus();
    return;
  }

  speakBtn.disabled = true;
  speakBtn.classList.add('generating');
  speakBtn.querySelector('span').textContent = 'Synthesizing Audio...';
  setStatus(`Generating speech with ${selectedVoiceName} (${selectedVoiceId})...`, 'busy');

  try {
    const speed = parseFloat(speedEl.value);
    const res = await fetch(`${API_URL}/speak`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        text: text,
        voice: selectedVoiceId,
        speed: speed
      })
    });

    if (!res.ok) {
      const errData = await res.json().catch(() => ({}));
      throw new Error(errData.error || `Server responded with ${res.status}`);
    }

    const blob = await res.blob();
    const audioUrl = URL.createObjectURL(blob);
    
    player.src = audioUrl;
    player.classList.add('show');
    player.play();

    setStatus(`Successfully synthesized speech using ${selectedVoiceName}.`, 'ok');
    addToHistory(text, selectedVoiceName, speed);

  } catch (e) {
    setStatus('Error: ' + e.message, 'err');
  } finally {
    speakBtn.disabled = false;
    speakBtn.classList.remove('generating');
    speakBtn.querySelector('span').textContent = 'Generate & Play Audio';
  }
}

speakBtn.onclick = generateSpeech;

document.addEventListener('keydown', (e) => {
  if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
    generateSpeech();
  }
});

function addToHistory(text, voiceName, speed) {
  const emptyHistory = historyEl.querySelector('.empty');
  if (emptyHistory) emptyHistory.remove();

  const timeStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
  
  const item = document.createElement('div');
  item.className = 'history-item';
  item.innerHTML = `
    <div class="info">
      <div class="text">${escapeHtml(text)}</div>
      <div class="meta">${voiceName} · ${speed}× · ${timeStr}</div>
    </div>
    <button>Replay</button>
  `;

  const replayBtn = item.querySelector('button');
  replayBtn.onclick = () => {
    textEl.value = text;
    textEl.oninput();
    generateSpeech();
  };

  historyEl.prepend(item);

  // Keep max 5 history items
  const items = historyEl.querySelectorAll('.history-item');
  if (items.length > 5) {
    items[items.length - 1].remove();
  }
}

function escapeHtml(str) {
  return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}

// Initialize
loadVoices();
</script>
</body>
</html>