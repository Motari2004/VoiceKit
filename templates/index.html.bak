          <div class="chip-content">
            <span class="chip-name">Nova</span>
            <span class="chip-desc">Crisp, modern</span>
          </div>
          <button class="chip-play" data-id="af_nova" title="Preview Nova">▶</button>
        </div>
        <div class="voice-chip" data-id="af_river" data-name="river" data-lang="American English" data-gender="female" title="River — Calm, flowing">
          <div class="chip-content">
            <span class="chip-name">River</span>
            <span class="chip-desc">Calm, flowing</span>
          </div>
          <button class="chip-play" data-id="af_river" title="Preview River">▶</button>
        </div>
        <div class="voice-chip" data-id="af_jessica" data-name="jessica" data-lang="American English" data-gender="female" title="Jessica — Confident, sharp">
          <div class="chip-content">
            <span class="chip-name">Jessica</span>
            <span class="chip-desc">Confident, sharp</span>
          </div>
          <button class="chip-play" data-id="af_jessica" title="Preview Jessica">▶</button>
        </div>
        <div class="voice-chip" data-id="af_kore" data-name="kore" data-lang="American English" data-gender="female" title="Kore — Warm, poetic">
          <div class="chip-content">
            <span class="chip-name">Kore</span>
            <span class="chip-desc">Warm, poetic</span>
          </div>
          <button class="chip-play" data-id="af_kore" title="Preview Kore">▶</button>
        </div>
        <div class="voice-chip" data-id="af_aoede" data-name="aoede" data-lang="American English" data-gender="female" title="Aoede — Melodic, lyrical">
          <div class="chip-content">
            <span class="chip-name">Aoede</span>
